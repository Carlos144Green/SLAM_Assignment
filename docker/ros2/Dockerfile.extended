# syntax=docker/dockerfile:1

ARG BASE_FROM
FROM ${BASE_FROM} AS extended

ARG GTSAM_REF=release/4.3a1
ARG RERUN_VERSION=0.31.3
ARG HUGGINGFACE_HUB_VERSION=0.36.2

RUN --mount=type=cache,target=/var/cache/apt \
    --mount=type=cache,target=/var/lib/apt/lists \
    apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    ninja-build \
    libboost-all-dev \
    libgoogle-glog-dev \
    libgflags-dev \
    libsuitesparse-dev \
    libeigen3-dev \
    libatlas-base-dev \
    python3-pip \
    libtbb-dev libmetis-dev \
    zenity \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --break-system-packages --no-cache-dir \
    "huggingface-hub[cli,hf_xet]==${HUGGINGFACE_HUB_VERSION}"

RUN git clone --recursive --branch ${GTSAM_REF} https://github.com/borglab/gtsam.git /tmp/gtsam \
    && cmake -S /tmp/gtsam -B /tmp/gtsam/build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DGTSAM_USE_BOOST_FEATURES=OFF \
        -DGTSAM_ENABLE_BOOST_SERIALIZATION=OFF \
    && cmake --build /tmp/gtsam/build --target install --parallel "$(nproc)" \
    && ldconfig \
    && rm -rf /tmp/gtsam

RUN wget -O /usr/local/bin/rerun \
    "https://github.com/rerun-io/rerun/releases/download/${RERUN_VERSION}/rerun-cli-${RERUN_VERSION}-x86_64-unknown-linux-gnu" \
    && chmod +x /usr/local/bin/rerun
